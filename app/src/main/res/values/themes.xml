<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark window so there is no white flash before Compose draws its first frame. -->
    <style name="Theme.Luna" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/luna_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
